# Copy to apps/api/.env on the server
PORT=3001
WEB_URL=http://zegbot.wachatpilot.com
COOKIE_DOMAIN=.wachatpilot.com
OPENAI_API_KEY=
WHATSAPP_SESSION_DIR=/var/www/zegbot/sessions
WHATSAPP_DEVICE_NAME=Zegbot Server
HUMAN_MODE=true
DATA_DIR=/var/www/zegbot/data

DATABASE_URL="mysql://zegbot:CHANGE_ME@localhost:3306/zegbot"

ADMIN_EMAIL=admin@zegbot.local
ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
COOKIE_SECURE=false
COOKIE_DOMAIN=

RESEND_API_KEY=
APP_NAME=Zegbot
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://api.zegbot.wachatpilot.com/channels/messenger/callback
