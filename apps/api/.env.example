PORT=3001
WEB_URL=http://zegbot.local
OPENAI_API_KEY=
WHATSAPP_SESSION_DIR=../../sessions
# Name shown in WhatsApp > Linked devices
WHATSAPP_DEVICE_NAME=Chrome

# Human-like sending (read receipt -> typing -> delay -> send)
HUMAN_MODE=true
HUMAN_READ_DELAY_MIN_MS=900
HUMAN_READ_DELAY_MAX_MS=2600
HUMAN_TYPING_CPS=10
HUMAN_TYPING_MIN_MS=1200
HUMAN_TYPING_MAX_MS=12000
HUMAN_ATTACHMENT_GAP_MIN_MS=1200
HUMAN_ATTACHMENT_GAP_MAX_MS=3600

# Send pacing — gap between any two sends, and between sends to the same contact
HUMAN_SEND_GAP_MIN_MS=2500
HUMAN_SEND_GAP_MAX_MS=7000
HUMAN_CONTACT_GAP_MIN_MS=1200
HUMAN_CONTACT_GAP_MAX_MS=3000

# Daily caps. HUMAN_WARMUP ramps a new number up over its first 6 days.
HUMAN_DAILY_CAP=500
HUMAN_DAILY_NEW_CONTACT_CAP=100
HUMAN_WARMUP=true

# Quiet hours, server local time, e.g. 23-7. Empty = send any time.
HUMAN_QUIET_HOURS=
HUMAN_MAX_DEFER_MS=43200000

# Warn in the logs when identical text reaches this many contacts in an hour
HUMAN_DUPLICATE_WARN_THRESHOLD=5
DATA_DIR=../../data
PLANS_DATA_FILE=../../data/plans.json

# MySQL (WAMP)
DATABASE_URL="mysql://root:@localhost:3306/zegbot"

# Admin login (web only at /admin/login)
ADMIN_EMAIL=admin@zegbot.local
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-jwt-secret

# Sessions: short access token, long refresh token. Users stay logged in until
# they log out, or after this many days of not opening the app.
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
# Set COOKIE_SECURE=true once the site is served over HTTPS
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Email — Resend takes priority, then SMTP (MAIL_* or SMTP_*), else links are logged
RESEND_API_KEY=
APP_NAME=Zegbot
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
# Legacy aliases (still supported)
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Messenger / Facebook Login (optional — onboarding uses this when set)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://api.zegbot.local/channels/messenger/callback
