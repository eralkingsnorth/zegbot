{
  "name": "zegbot",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@zegbot/api",
    "dev:web": "npm run dev --workspace=@zegbot/web",
    "dev:mobile": "npm run dev --workspace=@zegbot/mobile",
    "dev": "npm run dev:api & npm run dev:web",
    "build": "npm run build --workspaces --if-present",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
